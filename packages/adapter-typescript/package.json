{
  "name": "@lbr/adapter-typescript",
  "version": "0.0.1",
  "description": "Populates the Live Build Runtime project graph from a real TypeScript source tree.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "lbr": "./dist/cli.js" },
  "exports": { ".": "./dist/index.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lbr/runtime-core": "0.0.1",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "vitest": "^2.1.4"
  }
}
